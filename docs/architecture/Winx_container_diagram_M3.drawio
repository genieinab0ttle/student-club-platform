<mxfile host="app.diagrams.net"><diagram name="Container diagram" id="cont"><mxGraphModel dx="1200" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="Container diagram (Milestone 3): Student Club Management Platform" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="150" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="c3" value="Student Club Management Platform [Software system]" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;dashed=1;dashPattern=8 6;align=left;verticalAlign=bottom;spacingLeft=14;spacingBottom=8;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="250" y="280" width="700" height="670" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Web App&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Container: React + Vite, localhost:5173]&lt;br&gt;&lt;br&gt;&lt;b&gt;Implemented:&lt;/b&gt; create a meeting and see the meeting list.&lt;br&gt;Other pages are planned. Never accesses the database directly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f77c9;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="340" height="120" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Backend API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Container: Java 17, Spring Boot, localhost:8080]&lt;br&gt;&lt;br&gt;&lt;b&gt;Implemented:&lt;/b&gt; Meetings module (Controller → Service → Repository). Rejects blank fields and past dates.&lt;br&gt;Other modules are planned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f77c9;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="340" height="140" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Database&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;br&gt;&lt;b&gt;Implemented:&lt;/b&gt; meetings table (id, title, date, time, location).&lt;br&gt;Other tables are planned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a5fa3;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="770" width="340" height="150" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Club Member&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="21" y="60" width="222" height="70" as="geometry" /></mxCell><mxCell id="c8" value="Views the meeting list&lt;br&gt;&lt;i&gt;[HTTP]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.147;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Club Head&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="255" y="60" width="222" height="70" as="geometry" /></mxCell><mxCell id="c10" value="Creates and views meetings&lt;br&gt;&lt;i&gt;[HTTP]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.324;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Club Candidate&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="489" y="60" width="222" height="70" as="geometry" /></mxCell><mxCell id="c12" value="Reserves interview slots&lt;br&gt;&lt;i&gt;(planned)&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#999999;strokeWidth=2;fontSize=11;fontColor=#777777;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="c11" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Room Coordinator&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="723" y="60" width="222" height="70" as="geometry" /></mxCell><mxCell id="c14" value="Approves room requests&lt;br&gt;&lt;i&gt;(planned)&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#999999;strokeWidth=2;fontSize=11;fontColor=#777777;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.676;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="c13" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;University Finance Staff&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="957" y="60" width="222" height="70" as="geometry" /></mxCell><mxCell id="c16" value="Assigns budgets&lt;br&gt;&lt;i&gt;(planned)&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#999999;strokeWidth=2;fontSize=11;fontColor=#777777;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.853;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="c15" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" value="POST / GET /api/meetings&lt;br&gt;&lt;i&gt;[JSON / HTTP]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" value="Reads and writes meetings&lt;br&gt;&lt;i&gt;[Spring Data JPA / SQL]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="leg1" vertex="1" parent="1" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid line: implemented in Milestone 3&lt;br&gt;Dashed grey line: planned, not implemented yet&lt;br&gt;&lt;br&gt;The prototype runs locally over HTTP (HTTPS is planned for deployment).&lt;br&gt;There is no login or role check yet, so roles are not enforced." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#bbbbbb;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacing=10;arcSize=6;"><mxGeometry x="965" y="700" width="225" height="190" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>