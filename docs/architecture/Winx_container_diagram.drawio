<mxfile host="app.diagrams.net"><diagram name="Container diagram" id="cont"><mxGraphModel dx="1200" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Container diagram: Student Club Management Platform" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="150" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Student Club Management Platform [Software system]" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;dashed=1;dashPattern=8 6;align=left;verticalAlign=bottom;spacingLeft=14;spacingBottom=8;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="250" y="280" width="700" height="670" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Web App&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Container: Web browser app, React]&lt;br&gt;&lt;br&gt;Shows schedules, announcements, request forms and budget pages for each role. Never accesses the database directly.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f77c9;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="340" height="120" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Backend API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Container: Java application]&lt;br&gt;&lt;br&gt;Applies all business rules: SDU-email sign-in, role and club access checks, meetings, room requests without overlaps, announcements, interview reservations, budgets and expenses.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f77c9;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="340" height="140" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Database&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;br&gt;Stores approved users, clubs, rooms, meetings, room requests, announcements, interview slots and reservations, budgets and expenses (KZT).' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a5fa3;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="770" width="340" height="150" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Club Member&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="21" y="60" width="222" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Views schedules and&lt;br&gt;announcements&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.147;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Club Head&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="255" y="60" width="222" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Manages meetings, rooms,&lt;br&gt;interviews, expenses&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.324;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Club Candidate&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="489" y="60" width="222" height="70" as="geometry"/></mxCell><mxCell id="c12" value="Views and reserves&lt;br&gt;interview slots&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Room Coordinator&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="723" y="60" width="222" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Approves or rejects&lt;br&gt;room requests&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.676;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;University Finance Staff&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b4884;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="957" y="60" width="222" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Assigns budgets,&lt;br&gt;reviews expenses&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.853;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="Sends requests&lt;br&gt;&lt;i&gt;[JSON / HTTPS]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="Reads and writes&lt;br&gt;&lt;i&gt;[SQL]&lt;/i&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>