<mxfile host="app.diagrams.net"><diagram name="Class diagram" id="cls"><mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Class diagram (Milestone 3): Create and view meetings" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="150" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Repository pattern&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;fillColor=#fff8e6;strokeColor=#d9a400;strokeWidth=2;dashed=1;dashPattern=8 5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#8a6500;" vertex="1" parent="1"><mxGeometry x="495" y="300" width="785" height="385" as="geometry"/></mxCell><mxCell id="c4" value='&lt;p style="margin:4px 0 0 0;text-align:center;font-size:11px;color:#555"&gt;«RestController»&lt;/p&gt;&lt;p style="margin:2px 0 4px 0;text-align:center;font-size:14px"&gt;&lt;b&gt;MeetingController&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px;"&gt;- meetingService: MeetingService&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px 6px 8px;"&gt;+ createMeeting(meeting: Meeting): Meeting&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;POST /api/meetings → 201, uses @Valid&lt;/i&gt;&lt;br&gt;+ getAllMeetings(): List&amp;lt;Meeting&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;GET /api/meetings&lt;/i&gt;&lt;br&gt;+ handleInvalidMeeting(e): String&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;IllegalArgumentException → 400&lt;/i&gt;&lt;/p&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#111111;fillColor=#eaf2fb;strokeColor=#1f5fa3;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="390" height="178" as="geometry"/></mxCell><mxCell id="c5" value='&lt;p style="margin:4px 0 0 0;text-align:center;font-size:11px;color:#555"&gt;«Service»&lt;/p&gt;&lt;p style="margin:2px 0 4px 0;text-align:center;font-size:14px"&gt;&lt;b&gt;MeetingService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px;"&gt;- meetingRepository: MeetingRepository&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px 6px 8px;"&gt;+ createMeeting(meeting: Meeting): Meeting&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;rejects a date before today&lt;/i&gt;&lt;br&gt;+ getAllMeetings(): List&amp;lt;Meeting&amp;gt;&lt;/p&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#111111;fillColor=#eaf2fb;strokeColor=#1f5fa3;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="390" height="128" as="geometry"/></mxCell><mxCell id="c6" value='&lt;p style="margin:4px 0 0 0;text-align:center;font-size:11px;color:#555"&gt;«interface»&lt;/p&gt;&lt;p style="margin:2px 0 4px 0;text-align:center;font-size:14px"&gt;&lt;b&gt;MeetingRepository&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px 6px 8px;"&gt;extends JpaRepository&amp;lt;Meeting, Long&amp;gt;&lt;br&gt;&lt;i&gt;no extra methods&lt;/i&gt;&lt;/p&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#111111;fillColor=#fff1c7;strokeColor=#b38600;" vertex="1" parent="1"><mxGeometry x="530" y="350" width="310" height="110" as="geometry"/></mxCell><mxCell id="c7" value='&lt;p style="margin:4px 0 0 0;text-align:center;font-size:11px;color:#555"&gt;«interface» Spring Data&lt;/p&gt;&lt;p style="margin:2px 0 4px 0;text-align:center;font-size:14px"&gt;&lt;b&gt;JpaRepository&amp;lt;Meeting, Long&amp;gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px 6px 8px;"&gt;+ save(meeting: Meeting): Meeting&lt;br&gt;+ findAll(): List&amp;lt;Meeting&amp;gt;&lt;/p&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#111111;fillColor=#f3f3f3;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="930" y="350" width="330" height="110" as="geometry"/></mxCell><mxCell id="c8" value='&lt;p style="margin:4px 0 0 0;text-align:center;font-size:11px;color:#555"&gt;generated at runtime&lt;/p&gt;&lt;p style="margin:2px 0 4px 0;text-align:center;font-size:14px"&gt;&lt;b&gt;Spring Data JPA implementation&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px 6px 8px;"&gt;Spring creates this class automatically;&lt;br&gt;we do not write SQL by hand&lt;/p&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#111111;fillColor=#f3f3f3;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="530" y="545" width="310" height="115" as="geometry"/></mxCell><mxCell id="c9" value='&lt;p style="margin:4px 0 0 0;text-align:center;font-size:11px;color:#555"&gt;«Entity»  table: meetings&lt;/p&gt;&lt;p style="margin:2px 0 4px 0;text-align:center;font-size:14px"&gt;&lt;b&gt;Meeting&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px;"&gt;- id: Long  &lt;i&gt;(generated)&lt;/i&gt;&lt;br&gt;- title: String  &lt;i&gt;@NotBlank&lt;/i&gt;&lt;br&gt;- date: LocalDate  &lt;i&gt;@NotNull&lt;/i&gt;&lt;br&gt;- time: LocalTime  &lt;i&gt;@NotNull&lt;/i&gt;&lt;br&gt;- location: String  &lt;i&gt;@NotBlank&lt;/i&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:2px 8px 6px 8px;"&gt;+ getters and setters&lt;/p&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#111111;fillColor=#eaf2fb;strokeColor=#1f5fa3;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="390" height="165" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;meetings table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a5fa3;strokeColor=none;fontColor=#ffffff;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="745" width="250" height="55" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Legend (UML)&lt;/b&gt;&lt;br&gt;Solid line, open arrow: uses (a field set in the constructor)&lt;br&gt;Solid line, hollow triangle: extends&lt;br&gt;Dashed line, hollow triangle: implements&lt;br&gt;Dashed line, open arrow: depends on / works with&lt;br&gt;&lt;br&gt;Yellow frame: the classes that form the Repository pattern. MeetingService is its client." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#bbbbbb;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacing=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="905" y="715" width="375" height="165" as="geometry"/></mxCell><mxCell id="c12" value="delegates" style="html=1;rounded=0;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;kind=assoc;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="uses&lt;br&gt;save(), findAll()" style="html=1;rounded=0;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;kind=assoc;exitX=1;exitY=0.586;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="extends" style="html=1;rounded=0;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;kind=gen;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="implements" style="html=1;rounded=0;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;kind=real;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="works with" style="html=1;rounded=0;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;kind=dep;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="stores" style="html=1;rounded=0;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;kind=dep;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="SQL" style="html=1;rounded=0;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;kind=dep;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>